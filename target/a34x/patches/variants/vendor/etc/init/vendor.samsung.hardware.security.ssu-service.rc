service ssu-teecl /vendor/bin/vendor.samsung.hardware.security.ssu-service
    interface aidl vendor.samsung.hardware.security.ssu.ISehSSUTEECL/default
    class hal
    disabled
    user system
    group system

on property:ssu.support=0
    stop ssu-teecl

on property:ro.boot.em.model=SM-A346E
    setprop ssu.support 0
    stop ssu-teecl

on property:ro.boot.em.model=SM-A346B
    setprop ssu.support 0
    stop ssu-teecl


