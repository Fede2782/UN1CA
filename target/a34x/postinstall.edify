package_extract_file("scp-A346B-verified.img", "/dev/block/by-name/scp1");

# DTBO
ui_print("Full Patching dtbo.img img...");
package_extract_file("dtbo-A346B-verified.img", "/dev/block/by-name/dtbo");

else

